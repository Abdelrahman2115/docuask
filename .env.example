# Copy this file to .env and fill in your values.
# .env is ignored by git — never commit real keys.

# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Only needed if you switch llm.provider to "ollama" in config.yaml
OLLAMA_BASE_URL=http://localhost:11434

# Optional overrides (otherwise config.yaml is used)
# DOCUASK_LLM_PROVIDER=groq
# DOCUASK_LLM_MODEL=openai/gpt-oss-20b
